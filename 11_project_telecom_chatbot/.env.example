# Optional local override: the repository root .env is also loaded.
# Only Groq is required for answers. Ingestion runs with local embeddings.
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# Optional for Hugging Face downloads; the embedding model is public.
# HF_TOKEN=your_huggingface_token_here
